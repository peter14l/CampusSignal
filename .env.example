# CampusSignal Environment Template
# Copy this file to .env and populate with your credentials.

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Google Gemini Multimodal Vision API Key for Poster OCR
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth Server Client ID (Web Client ID for Android/iOS token verification)
GOOGLE_SERVER_CLIENT_ID=your-google-server-client-id.apps.googleusercontent.com

# Cloudflare R2 Storage (Optional - overrides default CDN bucket)
R2_PUBLIC_BASE_URL=https://pub-a56b2096b15c42f3b81606f43267e8c8.r2.dev/posters
